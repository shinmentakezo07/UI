{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "AUTH_SECRET",
        "NEXTAUTH_URL",
        "OPENAI_API_KEY",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SECRET_KEY",
        "POSTGRES_URL",
        "POSTGRES_HOST",
        "SUPABASE_PUBLISHABLE_KEY",
        "POSTGRES_DATABASE",
        "POSTGRES_PASSWORD",
        "POSTGRES_URL_NON_POOLING",
        "SUPABASE_SERVICE_ROLE_KEY",
        "POSTGRES_USER",
        "SUPABASE_JWT_SECRET",
        "NEXT_PUBLIC_SUPABASE_URL",
        "SUPABASE_URL",
        "POSTGRES_PRISMA_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
